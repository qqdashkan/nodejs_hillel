doctype html
html
  head
    meta(charset='utf-8')
    title= title || 'Express + Pug'
    link(rel="stylesheet" href="/css/style.css")
    style.
      nav { background: #f0f0f0; padding: 10px; margin-bottom: 20px; }
      nav a { margin-right: 15px; }
      .user-info { float: right; }
  body
    nav
      a(href='/') Home
      a(href='/about') About
      if user
        a(href='/only-users') Protected Page
        if user.role === 'admin'
          a(href='/admin') Admin Page
      .user-info
        if user
          span Welcome, #{user.username}. Email: #{user.email} - Role: #{user.role} / 
          a(href='/logout') Logout
        else
          a(href='/register') Create
          a(href='/login') Login
    
    block content
