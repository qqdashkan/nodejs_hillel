extends template.pug

block content
  .container.mt-4

    .row
      .col-12
      each val, key in items
        h1.text-center.mb-4= key
        each item in val
          .col-md-3.mb-4
            .card.h-100.p-2
              img.card-img-top(src=item.image alt=item.title)
              .card-body
                h5.card-title= item.title
                p.card-text= item.description
                p.card-text
                  b Price: #{item.price}
                p.card-text
                  | In stock:  #{item.stock}
              .card-footer
                a.btn.btn-primary(href=`/category/${item.category}/${item.url}`) View Details